#!/usr/bin/env python3
from __future__ import annotations
import html, json, re, sys, urllib.parse, urllib.request
from datetime import datetime, timezone
from pathlib import Path

ROOT=Path(__file__).resolve().parents[1]; PUBLIC=ROOT/'public'
PROJECT_ID='examdarpan-dd963'; BASE='https://examdarpan.in'
COLLECTION=f'https://firestore.googleapis.com/v1/projects/{PROJECT_ID}/databases/(default)/documents/posts'
MARKER='<!-- EXAM-DARPAN-GENERATED-ARTICLE -->'
WHATSAPP='https://chat.whatsapp.com/FaPxhlfwwBWDSmTWmkOrBQ'; TELEGRAM='https://t.me/examdarpanofficial'

def fs(v):
    if not isinstance(v,dict): return v
    for k in ('stringValue','timestampValue','referenceValue','bytesValue','booleanValue','doubleValue','integerValue'):
        if k in v:
            try: return int(v[k]) if k=='integerValue' else (float(v[k]) if k=='doubleValue' else v[k])
            except: return v[k]
    if 'nullValue' in v:return None
    if 'arrayValue' in v:return [fs(x) for x in v['arrayValue'].get('values',[])]
    if 'mapValue' in v:return {k:fs(x) for k,x in v['mapValue'].get('fields',{}).items()}
    return None

def fetch():
    """Fetch published posts using the OAuth session already used by Firebase CLI.

    This is intentionally authenticated; Firestore rules are never made public.
    """
    import os, subprocess

    token=os.environ.get('GOOGLE_OAUTH_ACCESS_TOKEN')
    if not token:
        candidates=[
            Path.home()/'.config'/'configstore'/'firebase-tools.json',
            Path.home()/'.config'/'firebase'/'firebase-tools.json',
            Path.home()/'.firebase'/'firebase-tools.json',
        ]
        for credfile in candidates:
            try:
                obj=json.loads(credfile.read_text(encoding='utf-8'))
                token=(obj.get('tokens') or {}).get('access_token')
                if token: break
            except Exception:
                continue

    if not token:
        raise RuntimeError('No Firebase CLI OAuth token found. Run `firebase login` once in Termux, then run this deploy again.')

    url=f'https://firestore.googleapis.com/v1/projects/{PROJECT_ID}/databases/(default)/documents:runQuery'
    body={'structuredQuery':{
        'from':[{'collectionId':'posts'}],
        'where':{'fieldFilter':{'field':{'fieldPath':'status'},'op':'EQUAL','value':{'stringValue':'published'}}},
        'orderBy':[{'field':{'fieldPath':'publishedAt'},'direction':'DESCENDING'}],
        'limit':300
    }}
    req=urllib.request.Request(url,data=json.dumps(body).encode('utf-8'),method='POST',headers={
        'Authorization':f'Bearer {token}','Content-Type':'application/json','User-Agent':'ExamDarpanStaticBuilder/2.0'
    })
    try:
        with urllib.request.urlopen(req,timeout=30) as r: raw=r.read().decode('utf-8','replace')
    except urllib.error.HTTPError as e:
        raw=e.read().decode('utf-8','replace')
        raise RuntimeError(f'Firestore API returned HTTP {e.code}: {raw[:500]}') from e

    try:
        rows=json.loads(raw)
    except json.JSONDecodeError as e:
        raise RuntimeError(f'Firestore API returned invalid JSON: {raw[:500]}') from e

    out=[]
    for row in rows if isinstance(rows,list) else []:
        d=row.get('document') if isinstance(row,dict) else None
        if not d: continue
        p={k:fs(v) for k,v in d.get('fields',{}).items()}
        p['id']=d.get('name','').rsplit('/',1)[-1]
        if p.get('status')=='published' and p.get('slug'): out.append(p)
    return sorted(out,key=lambda x:str(x.get('publishedAt') or ''),reverse=True)

def esc(v):return html.escape(str(v or ''),quote=True)
def slug(v):return re.sub(r'[^A-Za-z0-9._~-]+','-',str(v or '').strip().strip('/')).strip('-')
def date(v):
    if not v:return '—'
    try:
        d=datetime.fromisoformat(str(v).replace('Z','+00:00')); m=['जनवरी','फ़रवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर']; return f'{d.day:02d} {m[d.month-1]} {d.year}'
    except:return '—'
def iso(v):
    try:return datetime.fromisoformat(str(v).replace('Z','+00:00')).astimezone(timezone.utc).isoformat().replace('+00:00','Z') if v else None
    except:return None
def mins(c):return max(1,(len([x for x in re.sub(r'<[^>]+>',' ',str(c or '')).split() if x])+179)//180)
def actions(p):
    a=[]
    for k,l,c in [('applyOnlineUrl','Apply Online ↗','btn-primary'),('officialNotificationUrl','Official Notification ↗','btn-dark'),('officialWebsiteUrl','Official Website ↗','btn-gold'),('notificationPdfUrl','Notification PDF ↗','btn-dark')]:
        u=str(p.get(k) or '').strip()
        if u.startswith(('https://','http://')):a.append(f'<a class="btn {c}" href="{esc(u)}" target="_blank" rel="nofollow noopener">{l}</a>')
    return ''.join(a)

def page(p):
    title=str(p.get('title') or 'Exam Darpan Article').strip(); s=slug(p.get('slug')); cat=str(p.get('category') or 'Latest Updates').strip(); desc=str(p.get('excerpt') or 'Exam Darpan पर परीक्षा, भर्ती, admit card, result और सरकारी नौकरी की verified जानकारी पढ़ें।').strip(); img=str(p.get('featuredImage') or '').strip(); url=f'{BASE}/{urllib.parse.quote(s,safe="-._~")}'; pub=iso(p.get('publishedAt')); upd=iso(p.get('updatedAt')) or pub
    schema={'@context':'https://schema.org','@type':'Article','headline':title,'description':desc,'url':url,'mainEntityOfPage':{'@type':'WebPage','@id':url},'articleSection':cat,'author':{'@type':'Organization','name':'Exam Darpan Editorial Team','url':BASE+'/editorial-policy.html'},'publisher':{'@type':'Organization','name':'Exam Darpan','url':BASE+'/','logo':{'@type':'ImageObject','url':BASE+'/assets/logo.webp'}}}
    if pub:schema['datePublished']=pub
    if upd:schema['dateModified']=upd
    if img:schema['image']=[img]
    crumb={'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Home','item':BASE+'/'},{'@type':'ListItem','position':2,'name':cat,'item':BASE+'/?category='+urllib.parse.quote(cat)},{'@type':'ListItem','position':3,'name':title,'item':url}]}
    cover=f'<div class="article-cover article-cover-card" role="img" aria-label="{esc(title)}"><div class="article-cover-glow"></div><div class="article-cover-inner"><span class="article-cover-kicker">{esc(cat)}</span><h2>{esc(title)}</h2><div class="article-cover-brand"><strong>EXAM DARPAN</strong><span>Vacancy Se Result Tak, Har Jankari Ek Jagah</span></div></div></div>'
    links=actions(p); links=f'<div class="article-actions">{links}</div>' if links else ''
    content=str(p.get('content') or '<p>इस article का content अभी उपलब्ध नहीं है।</p>')
    return f'''{MARKER}
<!doctype html><html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{esc(title)} | Exam Darpan</title><meta name="description" content="{esc(desc[:155])}"><meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"><link rel="canonical" href="{esc(url)}"><meta property="og:type" content="article"><meta property="og:site_name" content="Exam Darpan"><meta property="og:title" content="{esc(title)} | Exam Darpan"><meta property="og:description" content="{esc(desc[:200])}"><meta property="og:url" content="{esc(url)}"><meta property="og:image" content="{esc(img or BASE+'/assets/logo.webp')}"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{esc(title)} | Exam Darpan"><meta name="twitter:description" content="{esc(desc[:200])}"><meta name="twitter:image" content="{esc(img or BASE+'/assets/logo.webp')}"><link rel="icon" href="/assets/favicon.webp"><link rel="stylesheet" href="/styles.css"><script type="application/ld+json">{json.dumps(schema,ensure_ascii=False,separators=(',',':'))}</script><script type="application/ld+json">{json.dumps(crumb,ensure_ascii=False,separators=(',',':'))}</script></head><body>
<div class="topbar"><div class="container topbar-inner"><span class="live"><i></i> LIVE</span><span>सरकारी नौकरी, परीक्षा और रिजल्ट की नवीनतम जानकारी</span><span class="topbar-dot">•</span><span class="topbar-note">Official source verify करें</span></div></div>
<header class="header"><div class="container head"><a class="brand" href="/" aria-label="Exam Darpan Home"><img src="/assets/logo.webp" width="52" height="52" alt="Exam Darpan logo"><div><div class="brand-title">EXAM<span>DARPAN</span></div><div class="tagline">Vacancy Se Result Tak, Har Jankari Ek Jagah</div></div></a><a class="btn btn-gold" href="/">Home</a></div><nav class="nav"><div class="container"><a href="/">Home</a><a href="/?category=Rajasthan%20Jobs">राजस्थान Jobs</a><a href="/?category=Government%20Jobs">All India Jobs</a><a href="/?category=Admit%20Card">Admit Card</a><a href="/?category=Results">Results</a><a href="/?category=Answer%20Key">Answer Key</a><a href="/?category=Syllabus">Syllabus</a></div></nav></header>
<main class="main container"><article class="article article-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/?category={urllib.parse.quote(cat)}">{esc(cat)}</a><span>›</span><span aria-current="page">{esc(title)}</span></nav><span class="badge">{esc(cat)}</span><h1>{esc(title)}</h1><div class="article-meta"><span>प्रकाशित: {date(p.get('publishedAt'))}</span><span>•</span><span>अपडेट: {date(p.get('updatedAt') or p.get('publishedAt'))}</span><span>•</span><span>{mins(p.get('content'))} min read</span></div>{cover}<div class="article-content">{content}</div><div class="notice"><strong>महत्वपूर्ण:</strong> आवेदन, फीस, पात्रता, परीक्षा या परिणाम से जुड़ी अंतिम कार्रवाई से पहले संबंधित विभाग की official notification जरूर verify करें।</div>{links}<section class="community-card"><div><span class="section-label">EXAM DARPAN COMMUNITY</span><h2>नई भर्ती और परीक्षा updates से जुड़े रहें</h2><p>Important vacancy, admit card, result और exam updates के लिए community से जुड़े रहें।</p></div><div class="community-actions"><a class="btn btn-primary" href="{TELEGRAM}" target="_blank" rel="noopener">Telegram</a><a class="btn btn-whatsapp" href="{WHATSAPP}" target="_blank" rel="noopener">WhatsApp Group</a></div></section></article></main>
<footer class="footer"><div class="container footer-grid"><div><h4>EXAM DARPAN</h4><p>Independent Education &amp; Government Job Information Portal.</p><p>© <span data-year></span> Exam Darpan · Independent Editorial Team</p></div><div><h4>Important</h4><p><a href="/about.html">About Us</a></p><p><a href="/editorial-policy.html">Editorial Policy</a></p><p><a href="/contact.html">Contact</a></p></div><div><h4>Legal</h4><p><a href="/privacy.html">Privacy Policy</a></p><p><a href="/disclaimer.html">Disclaimer</a></p><p><a href="/terms.html">Terms &amp; Conditions</a></p></div></div></footer><script>document.querySelectorAll('[data-year]').forEach(function(x){{x.textContent=new Date().getFullYear()}});</script></body></html>'''

def update_home(posts):
    path=PUBLIC/'index.html'
    text=path.read_text(encoding='utf-8')
    items=[]
    for i,p in enumerate(posts[:20]):
        s=slug(p.get('slug')); title=str(p.get('title') or 'Untitled'); cat=str(p.get('category') or 'Latest Update'); ex=str(p.get('excerpt') or 'Exam Darpan पर नवीनतम verified information पढ़ें।')
        img=str(p.get('featuredImage') or '')
        image=f'<img loading="lazy" decoding="async" src="{esc(img)}" alt="{esc(title)}" width="380" height="240">' if img.startswith(('https://','http://')) else ''
        cls=' featured-post' if i==0 else ''
        items.append(f'<article class="card post{cls}"><div class="post-top"><div class="post-copy"><span class="badge">{esc(cat)}</span><h2><a href="/{urllib.parse.quote(s,safe="-._~")}">{esc(title)}</a></h2><p>{esc(ex)}</p><div class="post-meta"><span>{date(p.get("publishedAt"))}</span><span>•</span><span>{mins(p.get("content"))} min read</span></div><a class="read-more" href="/{urllib.parse.quote(s,safe="-._~")}">पूरा article पढ़ें <b>→</b></a></div>{image}</div></article>')
    static='<!-- STATIC-POSTS-START -->'+''.join(items)+'<!-- STATIC-POSTS-END -->'
    import re
    text=re.sub(r'<!-- STATIC-POSTS-START -->.*?<!-- STATIC-POSTS-END -->',static,text,flags=re.S)
    if '<!-- STATIC-POSTS-START -->' not in text:
        text=text.replace('<div id="postsContainer" class="posts-grid"><div class="card empty">Updates load हो रहे हैं…</div></div>',f'<div id="postsContainer" class="posts-grid">{static}</div>')
    # Static matrix fallback, so important links exist even before JS executes.
    for element, cat in [('matrixLatestJobs','Rajasthan Jobs'),('matrixAdmitCards','Admit Card'),('matrixResults','Results')]:
        arr=[x for x in posts if x.get('category')==cat][:5] or posts[:5]
        block=''.join(f'<a class="matrix-item" href="/{urllib.parse.quote(slug(x.get("slug")),safe="-._~")}"><span>{esc(x.get("title") or "Untitled")}</span><small>{date(x.get("publishedAt"))}</small></a>' for x in arr)
        text=re.sub(rf'(<div id="{element}" class="matrix-list">).*?(</div>)',rf'\1<!-- STATIC-MATRIX -->{block}\2',text,flags=re.S)
    path.write_text(text,encoding='utf-8')

def main():
    try:posts=fetch()
    except Exception as e:print('ERROR: Firestore static build failed:',e,file=sys.stderr); return 2
    update_home(posts)
    for f in PUBLIC.glob('*.html'):
        try:
            if MARKER in f.read_text(encoding='utf-8',errors='ignore'):f.unlink()
        except:pass
    made=[]; seen=set()
    reserved={'index','article','about','privacy','contact','disclaimer','terms','editorial-policy','author','404'}
    for p in posts:
        s=slug(p.get('slug'))
        if not s or s in seen or s in reserved:continue
        (PUBLIC/f'{s}.html').write_text(page(p),encoding='utf-8');made.append(s);seen.add(s)
    urls=['/','/about.html','/contact.html','/editorial-policy.html','/privacy.html','/disclaimer.html','/terms.html']+['/'+urllib.parse.quote(s,safe='-._~') for s in made]
    xml='<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n'+''.join(f'<url><loc>{BASE}{html.escape(u)}</loc></url>\n' for u in urls)+'</urlset>\n'
    (PUBLIC/'sitemap.xml').write_text(xml,encoding='utf-8')
    print(f'Static SEO build: {len(made)} published article pages generated + sitemap.')
    return 0

if __name__=='__main__':raise SystemExit(main())
