{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(html|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/article/:slug*",
        "destination": "/:slug",
        "type": 301
      },
      {
        "regex": "^/(?P<path>.*)\\.html$",
        "destination": "/:path",
        "type": 301
      },
      {
        "source": "/rajasthan-safai-karmchari-recruitment-2026-24752",
        "destination": "/rajasthan-safai-karmchari-recruitment-2026",
        "type": 301
      }
    ],
    "rewrites": []
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
