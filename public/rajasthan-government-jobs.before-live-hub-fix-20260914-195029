<script id="raj-hub-dynamic-engine">
/* RAJASTHAN_HUB_DYNAMIC_V3 */

(async function(){

  const hub = document.getElementById("rajPosts");
  const countEl = document.getElementById("rajHubCount");
  const filterWrap = document.getElementById("rajHubFilters");

  if(!hub) return;


  /* -------------------------
     Safe helpers
  ------------------------- */

  const esc = value =>
    String(value ?? "").replace(/[&<>"]/g, ch => ({
      "&":"&amp;",
      "<":"&lt;",
      ">":"&gt;",
      '"':"&quot;"
    }[ch]));

  const strip = value =>
    String(value ?? "")
      .replace(/<[^>]*>/g," ")
      .replace(/\s+/g," ")
      .trim();

  const getDate = value => {
    try{
      const d = value?.toDate
        ? value.toDate()
        : new Date(value);

      return isNaN(d) ? null : d;
    }catch{
      return null;
    }
  };

  const slugOf = post => {

    let slug = String(post?.slug || "").trim();

    if(!slug && post?.url){

      try{
        slug = new URL(
          String(post.url),
          location.origin
        ).pathname.replace(/^\/+/,"");
      }catch{}
    }

    return slug
      .replace(/^\/+/,"")
      .split(/[?#]/)[0];
  };


  /* -------------------------
     IMPORTANT:
     Rajasthan identity is explicit.
     This prevents SSC/UPSC/Central
     Police posts from leaking here.
  ------------------------- */

  const isRajasthanPost = post => {

    const region =
      String(post?.region || "")
        .trim()
        .toLowerCase();

    const state =
      String(post?.state || "")
        .trim()
        .toLowerCase();

    const title =
      String(post?.title || post?.name || "")
        .toLowerCase();

    const category =
      String(post?.category || "")
        .toLowerCase();

    const text =
      strip(
        [
          post?.title,
          post?.name,
          post?.category,
          post?.region,
          post?.state
        ].join(" ")
      ).toLowerCase();


    if(region === "rajasthan") return true;

    if(state === "rajasthan") return true;

    /*
     * Explicit Rajasthan authority/title signals.
     */
    if(
      /rajasthan|राजस्थान|rpsc|rssb|rsmssb|reet|rvunl|rajcrb/i
        .test(title + " " + category)
    ){
      return true;
    }

    return false;
  };


  /* -------------------------
     Rajasthan category rules
  ------------------------- */

  const categoryRules = {

    rpsc:
      /\brpsc\b|ras\b|public\s+service\s+commission/i,

    rssb:
      /\brssb\b|\brsmssb\b|staff\s+selection\s+board/i,

    police:
      /rajasthan\s+police|police\s+constable|police\s+si|sub\s+inspector/i,

    teacher:
      /reet|teacher|third\s+grade|grade\s*3|school\s+lecturer|shikshak/i,

    cet:
      /rajasthan\s+cet|cet\s+senior|cet\s+graduate/i,

    clerical:
      /\bldc\b|clerk|junior\s+assistant|clerical/i,

    technical:
      /junior\s+engineer|\bje\b|technical/i,

    admit:
      /admit\s*card|admitcard|hall\s+ticket/i,

    result:
      /result|answer\s*key|answerkey|marksheet|परिणाम|उत्तर\s*कुंजी/i

  };


  const matchesCategory = (post,key) => {

    if(key === "all") return true;

    return categoryRules[key]
      ? categoryRules[key].test(
          strip([
            post?.title,
            post?.name,
            post?.category,
            post?.excerpt,
            post?.content
          ].join(" "))
        )
      : false;
  };


  /* -------------------------
     Render
  ------------------------- */

  const render = (allPosts,key) => {

    const list =
      allPosts.filter(
        post => matchesCategory(post,key)
      );


    if(countEl){

      countEl.textContent =
        list.length
          ? `${list.length} Rajasthan updates`
          : "इस category में अभी कोई Rajasthan article नहीं है";
    }


    if(!list.length){

      hub.innerHTML = `
        <div class="raj-empty">

          <strong>
            इस category का कोई Rajasthan article अभी उपलब्ध नहीं है।
          </strong>

          <br>

          आप Rajasthan Government Jobs Hub पर ही हैं।
          नया verified article आते ही यहाँ दिखाई देगा।

        </div>
      `;

      return;
    }


    hub.innerHTML = list.map(post => {

      const slug = slugOf(post);

      const title =
        strip(
          post?.title ||
          post?.name ||
          "Rajasthan Update"
        );

      const excerpt =
        strip(
          post?.excerpt ||
          post?.description ||
          post?.content ||
          ""
        ).slice(0,260);

      const category =
        strip(
          post?.category ||
          "Rajasthan Update"
        ) || "Rajasthan Update";


      const date =
        getDate(
          post?.publishedAt ||
          post?.createdAt ||
          post?.updatedAt
        );


      const dateText =
        date
          ? new Intl.DateTimeFormat(
              "hi-IN",
              {
                day:"2-digit",
                month:"short",
                year:"numeric"
              }
            ).format(date)
          : "";


      const href =
        slug
          ? "/" + encodeURIComponent(slug)
          : "/rajasthan-government-jobs";


      return `
        <article class="card post">

          <div class="post-copy">

            <span class="badge">
              ${esc(category)}
            </span>

            <h2>
              <a href="${esc(href)}">
                ${esc(title)}
              </a>
            </h2>

            ${
              excerpt
                ? `
                  <p>
                    ${esc(excerpt)}
                    ${excerpt.length >= 260 ? "…" : ""}
                  </p>
                `
                : ""
            }

            ${
              dateText
                ? `
                  <div class="post-meta">
                    <span>${esc(dateText)}</span>
                  </div>
                `
                : ""
            }

            <a
              class="read-more"
              href="${esc(href)}">
              पूरा article पढ़ें <b>→</b>
            </a>

          </div>

        </article>
      `;

    }).join("");
  };


  let posts = [];
  let active = "all";


  /* -------------------------
     Filter state
  ------------------------- */

  const setActive = key => {

    active = key || "all";

    filterWrap
      ?.querySelectorAll("[data-raj-filter]")
      .forEach(el => {

        el.classList.toggle(
          "active",
          el.dataset.rajFilter === active
        );

      });


    render(posts,active);


    /*
     * Same Rajasthan hub URL.
     * No unrelated article redirect.
     */
    history.replaceState(
      null,
      "",
      active === "all"
        ? "/rajasthan-government-jobs"
        : "/rajasthan-government-jobs?category=" +
          encodeURIComponent(active)
    );
  };


  filterWrap?.addEventListener(
    "click",
    event => {

      const button =
        event.target.closest("[data-raj-filter]");

      if(button){

        setActive(
          button.dataset.rajFilter
        );

        document
          .getElementById("latest")
          ?.scrollIntoView({
            behavior:"smooth",
            block:"start"
          });
      }

    }
  );


  /*
   * Bottom SEO category cards
   * use the same filter system.
   */
  document
    .querySelectorAll(
      "#rajSeoCategories [data-raj-filter]"
    )
    .forEach(link => {

      link.addEventListener(
        "click",
        event => {

          event.preventDefault();

          setActive(
            link.dataset.rajFilter
          );

          document
            .getElementById("latest")
            ?.scrollIntoView({
              behavior:"smooth",
              block:"start"
            });

        }
      );

    });


  /*
   * Direct URL:
   * /rajasthan-government-jobs?category=police
   */
  const urlKey =
    new URLSearchParams(
      location.search
    ).get("category");


  if(
    urlKey &&
    Object.prototype.hasOwnProperty.call(
      categoryRules,
      urlKey
    )
  ){
    active = urlKey;
  }


  hub.innerHTML = `
    <div class="raj-hub-loading">
      Rajasthan की latest verified updates load हो रही हैं…
    </div>
  `;


  /* -------------------------
     Firebase
  ------------------------- */

  try{

    if(!window.FIREBASE_CONFIG){

      const configScript =
        document.createElement("script");

      configScript.src =
        "/firebase-config.js";

      document.head.appendChild(
        configScript
      );

      await new Promise(
        (resolve,reject) => {

          configScript.onload = resolve;
          configScript.onerror = reject;

        }
      );
    }


    const [
      {initializeApp},
      {
        getFirestore,
        collection,
        getDocs,
        query,
        where,
        limit
      }
    ] = await Promise.all([

      import(
        "https://www.gstatic.com/firebasejs/12.5.0/firebase-app.js"
      ),

      import(
        "https://www.gstatic.com/firebasejs/12.5.0/firebase-firestore.js"
      )

    ]);


    const app =
      initializeApp(
        window.FIREBASE_CONFIG,
        "rajasthan-government-jobs-hub"
      );


    const db =
      getFirestore(app);


    const snapshot =
      await getDocs(
        query(
          collection(db,"posts"),
          where("status","==","published"),
          limit(200)
        )
      );


    posts =
      snapshot.docs
        .map(doc => ({
          id:doc.id,
          ...doc.data()
        }))
        .filter(isRajasthanPost)
        .sort(
          (a,b) =>
            (
              getDate(
                b.publishedAt ||
                b.createdAt ||
                b.updatedAt
              )?.getTime() || 0
            ) -
            (
              getDate(
                a.publishedAt ||
                a.createdAt ||
                a.updatedAt
              )?.getTime() || 0
            )
        );


    render(posts,active);


  }catch(error){

    console.error(
      "Rajasthan Government Jobs Hub load failed:",
      error
    );

    /*
     * Do NOT replace with SSC/UPSC/global content.
     * Keep safe Rajasthan static fallback.
     */
    if(countEl){
      countEl.textContent =
        "Rajasthan updates";
    }

  }

})();
</script>

<script src="/firebase-config.js"></script>

</body>
</html>
