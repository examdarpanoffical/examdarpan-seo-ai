  font-size:10px;
  font-weight:900;
}

.meta{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:8px;
  margin-top:12px;
}

.meta-box{
  padding:9px 10px;
  border-radius:10px;
  background:#f8fafc;
  border:1px solid #edf0f4;
}

.meta-box small{
  display:block;
  color:var(--muted);
  font-size:10px;
}

.meta-box strong{
  display:block;
  margin-top:2px;
  color:#172033;
  font-size:13px;
}

.actions{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:12px;
